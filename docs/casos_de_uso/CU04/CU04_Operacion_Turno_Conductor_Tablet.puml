@startuml CU04_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Conductor (Chofer)" as C
actor "Pasajero CONADIS" as Conadis
actor "Backend Central BC" as B

rectangle "Módulo de Cabina y Operación" {
  usecase "CU-04: Operar Turno de\nConducción en Tablet" as UC_Main
  
  usecase "CU-04.1: Autenticar Chofer\npor PIN" as UC_Inc1
  usecase "CU-04.2: Liquidar Turno\ny Generar Arqueo" as UC_Inc2
  usecase "CU-04.3: Monitorear Aforo\nSemafórico en Vivo" as UC_Inc3

  usecase "CU-08: Registrar Abordaje\nGratuito CONADIS (S/. 0.00)" as UC_Ext1
  usecase "CU-04.A: Declarar Avería Mecánica\ny Disparar Reembolso" as UC_Ext2
  usecase "CU-04.B: Calibrar Aforo por\nDesembarque Masivo" as UC_Ext3
}

C -- UC_Main
Conadis -- UC_Ext1

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include
UC_Main ..> UC_Inc3 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend
UC_Ext3 ..> UC_Main : extend

UC_Inc2 -- B
UC_Ext2 -- B
@enduml