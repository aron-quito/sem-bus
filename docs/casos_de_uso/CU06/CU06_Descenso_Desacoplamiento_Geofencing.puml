@startuml CU06_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Backend Central BC\n(Sistema Autónomo)" as B
actor "Pasajero" as P
actor "POS en Bus (GPS)" as POS

rectangle "Módulo de Telemetría y Desacoplamiento" {
  usecase "CU-06: Descenso y Desacoplamiento\npor Distancia GPS" as UC_Main
  
  usecase "CU-06.1: Evaluar Distancia\nRelativa Bus vs Celular" as UC_Inc1
  usecase "CU-06.2: Finalizar Sesión\nde Viaje y Desuscribir" as UC_Inc2

  usecase "CU-06.A: Emitir Alarma Anticipada\nde Bajada (400m)" as UC_Ext1
  usecase "CU-06.B: Cierre Forzoso por\nLlegada a Terminal" as UC_Ext2
  usecase "CU-06.C: Cierre de Sesión\npor Timeout Inactividad" as UC_Ext3
}

B -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend
UC_Ext3 ..> UC_Main : extend

UC_Inc1 -- POS
UC_Inc2 -- P
UC_Ext1 -- P
@enduml