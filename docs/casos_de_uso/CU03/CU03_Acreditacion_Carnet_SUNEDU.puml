@startuml CU03_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Pasajero Estudiante" as E
actor "Servicio SUNEDU" as S
actor "Auditor de Transporte\n(Admin Web)" as A

rectangle "Módulo de Beneficios y Tarifas" {
  usecase "CU-03: Acreditar Carnet\nUniversitario" as UC_Main
  
  usecase "CU-03.1: Decodificar y\nValidar QR SUNEDU" as UC_Inc1
  usecase "CU-03.2: Verificar Unicidad\nde DNI en Sistema" as UC_Inc2
  usecase "CU-03.3: Registrar Evidencia\ny Programar Vigencia" as UC_Inc3

  usecase "CU-03.A: Derivar a Cola de\nAuditoría Manual" as UC_Ext1
  usecase "CU-03.B: Rechazar por\nCaducidad Vencida" as UC_Ext2
  usecase "CU-03.C: Bloquear por\nDNI Duplicado" as UC_Ext3
}

E -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include
UC_Main ..> UC_Inc3 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend
UC_Ext3 ..> UC_Main : extend

UC_Inc1 -- S
UC_Ext1 -- A
@enduml