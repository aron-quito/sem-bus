@startuml CU00_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Pasajero" as P
actor "Pasarela SMS/WhatsApp\n(Twilio / Meta)" as SMS
actor "Backend Central BC" as B

rectangle "Módulo de Autenticación y Onboarding" {
  usecase "CU-00: Registrar e Iniciar\nSesión con Teléfono" as UC_Main
  
  usecase "CU-00.1: Despachar Código\nOTP de 6 Dígitos" as UC_Inc1
  usecase "CU-00.2: Validar Token OTP\ny Crear Sesión JWT" as UC_Inc2
  usecase "CU-00.3: Inicializar Monedero\nDigital (0 Pts)" as UC_Inc3

  usecase "CU-00.A: Reenviar OTP por\nCanal Alternativo (WhatsApp)" as UC_Ext1
  usecase "CU-00.B: Restaurar Saldo y\nPerfil Existente" as UC_Ext2
  usecase "CU-00.C: Bloquear por Exceso\nde Intentos Fallidos" as UC_Ext3
}

P -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include
UC_Main ..> UC_Inc3 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend
UC_Ext3 ..> UC_Main : extend

UC_Inc1 -- SMS
UC_Inc2 -- B
UC_Inc3 -- B
@enduml