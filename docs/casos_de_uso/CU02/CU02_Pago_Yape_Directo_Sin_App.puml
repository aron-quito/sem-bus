@startuml CU02_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Pasajero Sin App" as P
actor "Conductor (Chofer)" as C
actor "Pasarela Bancaria\n(Yape / Niubiz)" as Bank

rectangle "Módulo de Recaudación Directa" {
  usecase "CU-02: Pagar Directo con\nYape en POS (Sin App)" as UC_Main
  
  usecase "CU-02.1: Procesar Transacción\nBancaria Webhook" as UC_Inc1
  usecase "CU-01.2: Emitir Feedback\nen Hardware" as UC_Inc2

  usecase "CU-02.A: Autorizar Manualmente\npor Timeout (Failsafe 5s)" as UC_Ext1
  usecase "CU-02.B: Notificar Pago\nRechazado por Banco" as UC_Ext2
}

P -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend

UC_Inc1 -- Bank
UC_Ext1 -- C
UC_Inc2 -- C
@enduml