@startuml CU01_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Pasajero Registrado" as P
actor "Conductor (Chofer)" as C
actor "Backend BC" as B

rectangle "Módulo de Abordaje y Pasajes" {
  usecase "CU-01: Abordar y Pagar\ncon App en POS" as UC_Main
  
  usecase "CU-01.1: Validar y\nDebitar Puntos" as UC_Inc1
  usecase "CU-01.2: Emitir Feedback\nen Hardware" as UC_Inc2
  usecase "CU-01.3: Suscribir Sesión\na Unidad" as UC_Inc3

  usecase "CU-01.A: Aplicar Tarifa\nUniversitaria (7 Pts)" as UC_Ext1
  usecase "CU-01.B: Agregar Pasajes\nAcompañantes (+15 Pts)" as UC_Ext2
  usecase "CU-01.C: Notificar Saldo\nInsuficiente" as UC_Ext3
  usecase "CU-01.D: Manejar QR\nExpirado o Usado" as UC_Ext4
}

P -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include
UC_Main ..> UC_Inc3 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend
UC_Ext3 ..> UC_Main : extend
UC_Ext4 ..> UC_Main : extend

UC_Inc2 -- C
UC_Inc1 -- B
@enduml