@startuml Diagrama_Casos_de_Uso_BC
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam roundcorner 10
skinparam actorStyle awesome
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title Proyecto BC (Bus Conectado) - Diagrama General de Casos de Uso (UML 2.5)

actor "Pasajero Registrado" as Pasajero
actor "Pasajero Estudiante" as Estudiante
actor "Pasajero Sin App" as PasajeroDirecto
actor "Conductor / Chofer" as Chofer
actor "Administrador / Backoffice" as Admin
actor "Sistema Backend BC" as Backend <<System>>
actor "Pasarela Bancaria / SMS" as Pasarela <<Service>>
actor "Servicio SUNEDU" as Sunedu <<Service>>

Pasajero <|-- Estudiante

rectangle "Ecosistema de Transporte Urbano BC" {

  package "Módulo 1: Autenticación y Onboarding" {
    usecase "CU-00: Registrar e Iniciar Sesión con Teléfono" as CU00
    usecase "CU-00.1: Despachar Código OTP (SMS/WhatsApp)" as CU00_1
    usecase "CU-00.2: Validar OTP y Crear Sesión JWT" as CU00_2
    usecase "CU-00.4: Sesión Única por Dispositivo (Yape)" as CU00_4
    usecase "CU-00.B: Restaurar Saldo y Perfil" as CU00_B
  }

  package "Módulo 2: Monedero y Recargas" {
    usecase "CU-05: Recargar Puntos BC" as CU05
    usecase "CU-05.1: Iniciar Intención de Pago" as CU05_1
    usecase "CU-05.2: Asentar en Libro Mayor Ledger" as CU05_2
    usecase "CU-08: Consultar Historial de Gastos y Recargas" as CU08
  }

  package "Módulo 3: Abordaje y Pasajes en Bus" {
    usecase "CU-01: Abordar y Pagar con App en POS" as CU01
    usecase "CU-01.1: Validar con Bloqueo Pesimista (ACID)" as CU01_1
    usecase "CU-01.2: Emitir Feedback en Hardware" as CU01_2
    usecase "CU-01.3: Suscribir Sesión a Unidad" as CU01_3
    
    usecase "CU-01.A: Aplicar Tarifa Universitaria (7 Pts)" as CU01_A
    usecase "CU-01.B: Agregar Pasajes Acompañantes (+15 Pts)" as CU01_B
    usecase "CU-01.C: Notificar Saldo Insuficiente" as CU01_C

    usecase "CU-02: Pagar Directo con Yape en POS (Sin App)" as CU02
    usecase "CU-02.1: Procesar Transacción con Idempotencia" as CU02_1
    usecase "CU-02.A: Autorizar Manualmente por Timeout (5s)" as CU02_A
    
    usecase "CU-CONADIS: Registrar Abordaje Gratuito CONADIS" as CU_CONADIS
  }

  package "Módulo 4: Acreditaciones y Beneficios" {
    usecase "CU-03: Acreditar Carnet Universitario" as CU03
    usecase "CU-03.1: Decodificar y Validar QR SUNEDU" as CU03_1
    usecase "CU-03.2: Verificar Unicidad de DNI en BD" as CU03_2
    usecase "CU-03.P: Aplicar Prórroga Configurable SUNEDU" as CU03_P
  }

  package "Módulo 5: Cabina y Operación del Conductor" {
    usecase "CU-04: Operar Turno de Conducción en Tablet" as CU04
    usecase "CU-04.1: Autenticar Chofer por PIN" as CU04_1
    usecase "CU-04.2: Liquidar Turno y Generar Arqueo" as CU04_2
    usecase "CU-04.A: Declarar Avería Mecánica / Reembolso" as CU04_A
    usecase "CU-04.C: Pausar Bus en Mapa Público por Incidencia" as CU04_C
  }

  package "Módulo 6: Telemetría y Desacoplamiento" {
    usecase "CU-07: Consultar Rutas y Buses (Modo Invitado)" as CU07
    usecase "CU-07.C: Filtrar Unidades por Línea Específica" as CU07_C

    usecase "CU-06: Descenso y Desacoplamiento GPS (Anti-Jitter)" as CU06
    usecase "CU-06.1: Doble Verificación de Distancia" as CU06_1
    usecase "CU-06.2: Finalizar Sesión y Desuscribir" as CU06_2
  }

  package "Módulo 7: Soporte, Administración y Backoffice" {
    usecase "CU-09: Enviar Reportes, Sugerencias y Soporte" as CU09
    usecase "CU-10: Vincular Hardware Seguro (POS + Tablet + Bus)" as CU10
    usecase "CU-12: Administrar Sistema en Backoffice Web" as CU12
  }

  package "Módulo 8: Perfil, Privacidad y Regulación" {
    usecase "CU-11: Gestionar Perfil y Eliminación de Cuenta" as CU11
  }
}

' Relaciones Include / Extend clave
CU00 ..> CU00_1 : <<include>>
CU00 ..> CU00_2 : <<include>>
CU00 ..> CU00_4 : <<include>>
CU00_B ..> CU00 : <<extend>>

CU05 ..> CU05_1 : <<include>>
CU05 ..> CU05_2 : <<include>>

CU01 ..> CU01_1 : <<include>>
CU01 ..> CU01_2 : <<include>>
CU01 ..> CU01_3 : <<include>>
CU01_A ..> CU01 : <<extend>>
CU01_B ..> CU01 : <<extend>>
CU01_C ..> CU01 : <<extend>>

CU02 ..> CU02_1 : <<include>>
CU02 ..> CU01_2 : <<include>>
CU02_A ..> CU02 : <<extend>>

CU03 ..> CU03_1 : <<include>>
CU03 ..> CU03_2 : <<include>>
CU03_P ..> CU03 : <<extend>>

CU04 ..> CU04_1 : <<include>>
CU04 ..> CU04_2 : <<include>>
CU04_A ..> CU04 : <<extend>>
CU04_C ..> CU04 : <<extend>>

CU07_C ..> CU07 : <<extend>>
CU06 ..> CU06_1 : <<include>>
CU06 ..> CU06_2 : <<include>>

' Asociaciones de Actores
Pasajero --> CU00
Pasajero --> CU01
Pasajero --> CU05
Pasajero --> CU06
Pasajero --> CU07
Pasajero --> CU08
Pasajero --> CU09
Pasajero --> CU11

Estudiante --> CU03

PasajeroDirecto --> CU02
PasajeroDirecto --> CU_CONADIS

Chofer --> CU04
Chofer --> CU_CONADIS
Chofer --> CU02_A

Admin --> CU10
Admin --> CU12
Admin --> CU09

CU00_1 --> Pasarela
CU02_1 --> Pasarela
CU05_1 --> Pasarela
CU03_1 --> Sunedu

Backend --> CU01_1
Backend --> CU01_3
Backend --> CU04_A
Backend --> CU06_1
Backend --> CU07
Backend --> CU12

@enduml
