@startuml CU05_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Pasajero Registrado" as P
actor "Pasarela de Pagos\n(Yape / Tarjetas)" as Gate
actor "Backend BC" as B

rectangle "Módulo de Monedero Digital" {
  usecase "CU-05: Recargar Puntos BC" as UC_Main
  
  usecase "CU-05.1: Iniciar Intención\nde Pago Digital" as UC_Inc1
  usecase "CU-05.2: Asentar en Libro\nMayor (Ledger)" as UC_Inc2
  usecase "CU-05.3: Notificar Nuevo\nSaldo al Usuario" as UC_Inc3

  usecase "CU-05.A: Manejar Rechazo\nde Fondos Bancarios" as UC_Ext1
  usecase "CU-05.B: Cancelar Intención\npor Abandono" as UC_Ext2
}

P -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include
UC_Main ..> UC_Inc3 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend

UC_Inc1 -- Gate
UC_Inc2 -- B
@enduml