@startuml CU10_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Administrador de Transporte\n(Backoffice)" as Admin
actor "Módulo POS en Bus" as POS
actor "Tablet del Chofer" as Tablet
actor "Backend Central BC" as B

rectangle "Módulo de Gestión de Flota y Hardware Seguro" {
  usecase "CU-10: Vincular Hardware\nSeguro (POS + Tablet + Bus)" as UC_Main
  
  usecase "CU-10.1: Generar Token Criptográfico\nde Emparejamiento" as UC_Inc1
  usecase "CU-10.2: Validar Handshake y\nClaves de Dispositivo" as UC_Inc2
  usecase "CU-10.3: Asignar Certificado a la\nUnidad en Base de Datos" as UC_Inc3

  usecase "CU-10.A: Desvincular Dispositivo\npor Robo o Avería" as UC_Ext1
  usecase "CU-10.B: Reemplazo Rápido de\nDispositivo de Contingencia" as UC_Ext2
}

Admin -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include
UC_Main ..> UC_Inc3 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend

UC_Inc2 -- POS
UC_Inc2 -- Tablet
UC_Inc3 -- B
@enduml