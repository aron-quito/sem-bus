@startuml CU09_Diagrama_Casos_de_Uso
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam roundcorner 10

skinparam actor {
  BorderColor #2C3E50
  BackgroundColor #FFFFFF
}

skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2C3E50
  ArrowColor #2C3E50
}

skinparam rectangle {
  BorderColor #2C3E50
  BackgroundColor #FAFAFA
}

actor "Pasajero (Invitado o Registrado)" as P
actor "Administrador / Soporte\n(Panel Web)" as Admin

rectangle "Módulo de Atención y Soporte al Pasajero" {
  usecase "CU-09: Enviar Reporte,\nSugerencia o Incidencia" as UC_Main
  
  usecase "CU-09.1: Tipificar y Registrar\nTicket de Soporte" as UC_Inc1
  usecase "CU-09.2: Notificar Envío y\nCódigo de Seguimiento" as UC_Inc2

  usecase "CU-09.A: Adjuntar Captura\no Evidencia de Error" as UC_Ext1
  usecase "CU-09.B: Asociar Reporte a\nViaje Reciente Específico" as UC_Ext2
}

P -- UC_Main

UC_Main ..> UC_Inc1 : include
UC_Main ..> UC_Inc2 : include

UC_Ext1 ..> UC_Main : extend
UC_Ext2 ..> UC_Main : extend

UC_Inc1 -- Admin
@enduml